    {
      "name": "Animals",
      "item": [
        {
          "name": "List Animals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/animals?per_page=15",
              "query": [
                {"key": "per_page", "value": "15"}
              ]
            }
          }
        },
        {
          "name": "Get Animal",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/animals/2"
          }
        },
        {
          "name": "Create Animal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/animals",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "species", "value": "Camel"},
                {"key": "breed", "value": "Wadhah"},
                {"key": "gender", "value": "Male"},
                {"key": "date_of_birth", "value": "2021-01-01"},
                {"key": "name", "value": "Test Animal"}
              ]
            }
          }
        },
        {
          "name": "Update Animal",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/animals/2",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "name", "value": "Updated Name"}
              ]
            }
          }
        },
        {
          "name": "Delete Animal",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/animals/2"
          }
        },
        {
          "name": "Get Location History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/animals/2/location-history?hours=720",
              "query": [
                {"key": "hours", "value": "720"}
              ]
            }
          }
        },
        {
          "name": "Transfer Ownership",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/animals/2/transfer-ownership",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"owner_id\": 5\n}"
            }
          }
        }
      ]
    },
