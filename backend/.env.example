APP_NAME="Oasis Trace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8050
FRONTEND_URL=http://127.0.0.1:8050/app

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oasis_trace
DB_USERNAME=root
DB_PASSWORD=

# There are no sessions/jobs tables, so keep these on file/sync drivers.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Emails (password reset) are written to storage/logs/laravel.log locally.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@oasistrace.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8050,127.0.0.1,127.0.0.1:5173,127.0.0.1:8050

# Comma-separated origins allowed to call the API from a browser (any localhost port is allowed when APP_ENV=local)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8050

# Optional integrations (also configurable from Settings in the admin UI, which takes precedence)
STRIPE_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
SMS_ENABLED=false
SMS_FROM_NUMBER=
CALL_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_URL=
